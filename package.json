    "package": "node scripts/package-release.js",
    "version-check": "node scripts/version-check.js",
    "lint": "eslint --ext .jsx *.jsx",
    "clean": "rimraf dist/ temp/ *.log",
    "release": "npm run clean && npm run validate && npm run build && npm run package"
